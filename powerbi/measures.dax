// Sales performance semantic model. USD is a presentation convention, without conversion.
Calendar = CALENDAR(MIN(Sales[order_date]), MAX(Sales[order_date]))

Gross Revenue = SUM(Sales[gross_revenue])

Discount Amount = SUM(Sales[discount_amount])

Revenue Before Returns = SUM(Sales[revenue])

Returned Revenue = SUM(Sales[returned_revenue])

Net Revenue = SUM(Sales[net_revenue])

Orders = DISTINCTCOUNT(Sales[order_id])

Customers = DISTINCTCOUNT(Sales[customer_id])

Returned Orders = CALCULATE([Orders], Sales[is_returned] = 1)

Return Rate = DIVIDE([Returned Orders], [Orders])

Net AOV = DIVIDE([Net Revenue], [Orders])

Weighted Discount Rate = DIVIDE([Discount Amount], [Gross Revenue])
